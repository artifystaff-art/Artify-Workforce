<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!-- The device-bound session (device_id, refresh token, access token) must
         never be restored onto a different physical device: Android Keystore
         keys aren't portable across devices anyway, but excluding the file
         explicitly makes that guarantee independent of Keystore behavior. -->
    <exclude domain="sharedpref" path="artify_secure_session.xml"/>
</full-backup-content>
